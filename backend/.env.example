# Bind to 0.0.0.0 so a phone on the same Wi-Fi can reach this PC.
HOST=0.0.0.0
PORT=8000

# CPU-friendly multilingual Whisper model. Use small only if hardware permits.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama must be started locally. The name is intentionally not hard-coded.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-your-installed-model

# VOICEVOX Engine gives the MVP natural Japanese speech locally.
TTS_ENGINE=voicevox
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3

# Optional fallback for environments that cannot run VOICEVOX. Japanese quality
# depends on installed OS voices.
# TTS_ENGINE=pyttsx3
# PYTTSX3_VOICE_ID=
